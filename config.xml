<?xml version='1.0' encoding='utf-8'?>
<widget id="ph.edu.xu.fixtrck" version="0.3.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>FixTrck</name>
    <description>Campus facility repair reporting and tracking app for Xavier University - Ateneo de Cagayan</description>
    <author email="team@example.com">FixTrck Team</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackgroundColor" value="#FFF95C5C" />
    <preference name="StatusBarBackgroundColor" value="#F95C5C" />
    <preference name="Orientation" value="portrait" />
    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
    </platform>
</widget>
